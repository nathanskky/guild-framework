{
    "name": "guild/framework",
    "description": "IU-centric PHP framework for small projects.",
    "type": "library",
    "authors": [
        {
            "name": "Nathan Skky Rodriguez",
            "email": "nsrodrig@iu.edu"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/nathanskky/guild-access.git"
        }
    ],
    "require": {
        "php": "~8.5.0",
        "guild/access": "^1.0",
        "league/container": "^5.1",
        "league/route": "^6.2",
        "laminas/laminas-diactoros": "^3.6",
        "laminas/laminas-httphandlerrunner": "^2.12",
        "illuminate/database": "^13.19",
        "illuminate/events": "^13.19",
        "twig/twig": "^3.28",
        "latte/latte": "^3.1",
        "robmorgan/phinx": "^0.16.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.2",
        "laravel/pint": "^1.32"
    },
    "autoload": {
        "psr-4": {
            "Guild\\Framework\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Guild\\Framework\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@test",
            "@analyse",
            "@format:check"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite (fails if no tests run - tests/ is currently empty).",
        "analyse": "Run PHPStan at level 10 over src/.",
        "format": "Auto-fix code style with Pint (PSR-12).",
        "format:check": "Check code style with Pint (PSR-12) without modifying files.",
        "check": "Run tests, static analysis, then style check. Stops at the first failure."
    }
}
